generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// BUSINESS
// Negocio que utiliza el sistema de reservas
// ─────────────────────────────────────────────

model Business {
  id             String @id @default(cuid())
  businessTypeId String

  name        String
  slug        String  @unique
  description String?

  email    String?
  phone    String?
  address  String?
  city     String?
  country  String  @default("El Salvador")
  currency String  @default("USD")
  timezone String  @default("America/El_Salvador")

  // Usado principalmente por negocios de alojamiento.
  checkInTime  String?
  checkOutTime String?

  // Configuración general
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessType BusinessType @relation(fields: [businessTypeId], references: [id])

  services          Service[]
  resources         Resource[]
  resourceTypes     ResourceType[]
  schedules         Schedule[]
  availabilityRules AvailabilityRule[]

  customers    Customer[]
  reservations Reservation[]
  payments     Payment[]
  blocks       Block[]
  users        User[]

  @@index([businessTypeId])
}

// ─────────────────────────────────────────────
// BUSINESS TYPE
// Tipo de negocio
// ─────────────────────────────────────────────

model BusinessType {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses Business[]
}

// ─────────────────────────────────────────────
// SERVICE
// Servicio que ofrece el negocio
//
// Hotel:
//   Habitación Standard
//   Habitación Deluxe
//
// Restaurante:
//   Cena
//   Almuerzo
//
// Clínica:
//   Consulta general
//   Consulta nutricional
//
// Salón:
//   Corte
//   Manicure
// ─────────────────────────────────────────────

model Service {
  id         String @id @default(cuid())
  businessId String

  name        String
  slug        String
  description String?

  // Para reservas por tiempo:
  // consulta de 30 min, cena de 90 min, corte de 45 min, etc.
  durationMinutes Int?

  // Capacidad general.
  maxPeople Int @default(1)

  // Datos opcionales útiles para alojamiento.
  maxAdults   Int?
  maxChildren Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  resourceTypes ServiceResourceType[]
  reservations  ReservationService[]
  rates         ServiceRate[]
  blocks        Block[]

  @@unique([businessId, slug])
  @@index([businessId])
}

// ─────────────────────────────────────────────
// RESOURCE
// Recurso físico o asignable
//
// Hotel:
//   Habitación 101
//
// Restaurante:
//   Mesa 1
//
// Clínica:
//   Consultorio 1
//
// Salón:
//   Silla 3
// ─────────────────────────────────────────────

model Resource {
  id             String  @id @default(cuid())
  businessId     String
  resourceTypeId String?

  name String
  code String?

  floor    Int?
  capacity Int  @default(1)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  resourceType ResourceType? @relation(fields: [resourceTypeId], references: [id])

  reservations ReservationResource[]
  blocks       Block[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([resourceTypeId])
}

// ─────────────────────────────────────────────
// RESOURCE TYPE
//
// Hotel:
//   Standard
//   Deluxe
//   Suite
//
// Restaurante:
//   Mesa interior
//   Terraza
//
// Clínica:
//   Consultorio
// ─────────────────────────────────────────────

model ResourceType {
  id         String @id @default(cuid())
  businessId String

  name        String
  slug        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  resources Resource[]
  services  ServiceResourceType[]
  blocks    Block[]

  @@unique([businessId, slug])
  @@index([businessId])
}

// ─────────────────────────────────────────────
// SERVICE ↔ RESOURCE TYPE
//
// Define qué tipos de recursos pueden satisfacer
// un servicio.
//
// Hotel:
//   Standard → ResourceType Standard
//
// Restaurante:
//   Cena → ResourceType Mesa
//
// Clínica:
//   Consulta → ResourceType Consultorio
//
// Salón:
//   Corte → ResourceType Estación / Profesional
// ─────────────────────────────────────────────

model ServiceResourceType {
  id             String @id @default(cuid())
  serviceId      String
  resourceTypeId String

  requiredQuantity Int @default(1)

  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  resourceType ResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Cascade)

  @@unique([serviceId, resourceTypeId])
  @@index([serviceId])
  @@index([resourceTypeId])
}

// ─────────────────────────────────────────────
// RATE
// Tarifas para recursos/servicios
//
// Conservamos weekdayPrice y weekendPrice
// porque el hotel las necesita desde el inicio.
// ─────────────────────────────────────────────

model ServiceRate {
  id        String @id @default(cuid())
  serviceId String

  name String

  startDate DateTime
  endDate   DateTime

  weekdayPrice Decimal @db.Decimal(10, 2)
  weekendPrice Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, startDate, endDate])
}

// ─────────────────────────────────────────────
// SCHEDULE
// Horarios generales del negocio
//
// Ejemplo restaurante:
// Lunes 12:00 - 22:00
//
// Clínica:
// Lunes 08:00 - 17:00
//
// Salón:
// Lunes 09:00 - 19:00
// ─────────────────────────────────────────────
model Schedule {
  id         String @id @default(cuid())
  businessId String

  dayOfWeek Int

  startTime String
  endTime   String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
}

// ─────────────────────────────────────────────
// AVAILABILITY RULE
// Reglas especiales de disponibilidad
// ─────────────────────────────────────────────

model AvailabilityRule {
  id         String @id @default(cuid())
  businessId String

  name String?

  startDate DateTime?
  endDate   DateTime?

  startTime String?
  endTime   String?

  dayOfWeek Int?

  capacity Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────

model Customer {
  id         String @id @default(cuid())
  businessId String

  firstName String
  lastName  String

  email String?
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  reservations Reservation[]

  @@index([businessId])
  @@index([email])
  @@index([phone])
}

// ─────────────────────────────────────────────
// RESERVATION
// Reserva universal
//
// Hotel:
//   startAt = check-in
//   endAt   = check-out
//
// Restaurante:
//   startAt = hora de reserva
//   endAt   = hora de finalización
//
// Clínica:
//   startAt = inicio de consulta
//   endAt   = final de consulta
// ─────────────────────────────────────────────

model Reservation {
  id         String @id @default(cuid())
  businessId String
  customerId String

  confirmationCode String @unique

  // Intervalo universal de reserva.
  startAt DateTime
  endAt   DateTime

  // Capacidad universal.
  guests Int @default(1)

  // Opcionales para negocios de alojamiento.
  adults   Int?
  children Int?

  status ReservationStatus @default(PENDING)

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  paymentOption PaymentOption?

  specialRequests String?

  source ReservationSource @default(WEBSITE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id])

  services  ReservationService[]
  resources ReservationResource[]
  payments  Payment[]

  @@index([businessId, startAt, endAt])
  @@index([customerId])
  @@index([status])
}

// ─────────────────────────────────────────────
// RESERVATION SERVICE
// Servicios incluidos en una reserva
// ─────────────────────────────────────────────

model ReservationService {
  id            String @id @default(cuid())
  reservationId String
  serviceId     String

  quantity Int @default(1)

  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  service Service @relation(fields: [serviceId], references: [id])

  resources ReservationResource[]

  @@index([reservationId])
  @@index([serviceId])
}

// ─────────────────────────────────────────────
// RESERVATION RESOURCE
// Recurso físico asignado
// ─────────────────────────────────────────────

model ReservationResource {
  id                   String  @id @default(cuid())
  reservationId        String
  reservationServiceId String?
  resourceId           String

  createdAt DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  reservationService ReservationService? @relation(fields: [reservationServiceId], references: [id], onDelete: Cascade)

  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([reservationId, resourceId])
  @@index([reservationId])
  @@index([reservationServiceId])
  @@index([resourceId])
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id            String @id @default(cuid())
  businessId    String
  reservationId String

  amount Decimal @db.Decimal(10, 2)

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  externalReference String?
  paymentUrl        String?

  proofUrl     String?
  verifiedAt   DateTime?
  verifiedById String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  verifiedBy  User?       @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([reservationId])
  @@index([verifiedById])
  @@index([status])
}

// ─────────────────────────────────────────────
// BLOCK
// Bloqueo de recurso o servicio
// ─────────────────────────────────────────────

model Block {
  id         String @id @default(cuid())
  businessId String

  serviceId      String?
  resourceTypeId String?
  resourceId     String?

  startAt DateTime
  endAt   DateTime

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id])
  resourceType ResourceType? @relation(fields: [resourceTypeId], references: [id])
  resource     Resource?     @relation(fields: [resourceId], references: [id])

  @@index([businessId, startAt, endAt])
  @@index([serviceId])
  @@index([resourceTypeId])
  @@index([resourceId])
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id         String @id @default(cuid())
  businessId String

  name  String
  email String

  role UserRole @default(RECEPTIONIST)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  verifiedPayments Payment[] @relation("PaymentVerifiedBy")

  @@unique([businessId, email])
  @@index([businessId])
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
}

enum ReservationSource {
  WEBSITE
  WHATSAPP
  PHONE
  WALK_IN
  AIRBNB
  OTHER
}

enum PaymentMethod {
  PAYMENT_LINK
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentOption {
  FULL
  DEPOSIT_50
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum UserRole {
  OWNER
  ADMIN
  RECEPTIONIST
}
